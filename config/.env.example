# ===================================================
# Music Data Collector v2 - Environment Configuration
# ===================================================
# Copy this file to .env and fill in your values

# ─── Spotify API (REQUIRED for metadata extraction) ──
# Register app at: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIFY_REDIRECT_URI=http://127.0.0.1:9900/

# ─── YouTube / Cookies Settings ───────────────────────
# Option 1 (Recommended): Read cookies automatically from browser (e.g. chrome, edge, firefox)
COOKIES_FROM_BROWSER=chrome

# Option 2 (Fallback): Path to exported cookies.txt file
YOUTUBE_COOKIES_PATH=./config/cookies.txt

# ─── Database Configuration ───────────────────────────
# Supported: mongodb (default), postgresql
DB_ENGINE=mongodb

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=music_streaming

# PostgreSQL (alternative)
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=your_password
PG_DATABASE=music_streaming

# ─── Data Paths ───────────────────────────────────────
DATA_DIR=./data
AUDIO_DIR=./data/audio
IMAGES_DIR=./data/images
RAW_DIR=./data/raw
EXPORT_DIR=./data/exports
LOG_DIR=./logs
SESSION_DB_PATH=./data/session.db

# ─── Download & Rate Limiting Settings ────────────────
SPOTDL_THREADS=1
SPOTDL_BITRATE=192k
DOWNLOAD_DELAY_SECONDS=5.0
BATCH_SIZE=50
BATCH_COOLDOWN_SECONDS=120
MAX_DOWNLOAD_RETRIES=2

# ─── Health Checker & Resilience ──────────────────────
HEALTH_FAIL_THRESHOLD=5
HEALTH_WINDOW_SIZE=10
HEALTH_MAX_PAUSES=3
HEALTH_PAUSE_SECONDS=600

# ─── Proxy Settings (Optional Toggle) ─────────────────
PROXY_ENABLED=false
# Comma-separated list of proxies (e.g. socks5://127.0.0.1:1080,http://proxy.example.com:8080)
PROXY_LIST=
PROXY_ROTATION=round_robin

# ─── Dashboard Settings ───────────────────────────────
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=5000
DASHBOARD_DEBUG=false
